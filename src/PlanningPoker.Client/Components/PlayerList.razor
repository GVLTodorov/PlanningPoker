<div class="player-list">
    @foreach (var player in Players)
    {
        <PlayerCard @key="player.PlayerId" Player="player" IsLocalPlayer="@(player.PlayerId == LocalPlayerId)"
                    CanRemove="@(IsHost && player.PlayerId != LocalPlayerId)"
                    OnRemove="@(() => OnRemovePlayer.InvokeAsync(player.PlayerId))" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<PlayerResponse> Players { get; set; } = [];

    [Parameter]
    public Guid LocalPlayerId { get; set; }

    [Parameter]
    public bool IsHost { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRemovePlayer { get; set; }
}
