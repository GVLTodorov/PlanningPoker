@inject IJSRuntime JsRuntime

<div class="player-setup">
    <label class="field">
        <span class="field-label">Your name</span>
        <input class="text-input" id="@_nameInputId" type="text" maxlength="40" required
               value="@Name" @oninput="OnNameInput" placeholder="e.g. Noah" />
    </label>

    <div class="field">
        <span class="field-label">Choose an avatar</span>
        <AvatarPicker AvatarUrls="AvatarUrls" SelectedUrl="@AvatarUrl" SelectedUrlChanged="OnAvatarSelected" />
    </div>

    <label class="field checkbox-field">
        <input type="checkbox" checked="@IsSpectator" @onchange="OnSpectatorChanged" />
        <span>Join as spectator (watch without picking cards)</span>
    </label>
</div>

@code {
    private readonly string _nameInputId = $"player-name-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> NameChanged { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<string> AvatarUrls { get; set; } = [];

    [Parameter]
    public string? AvatarUrl { get; set; }

    [Parameter]
    public EventCallback<string> AvatarUrlChanged { get; set; }

    [Parameter]
    public bool IsSpectator { get; set; }

    [Parameter]
    public EventCallback<bool> IsSpectatorChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("focusElement", $"#{_nameInputId}");
    }

    private Task OnNameInput(ChangeEventArgs args) => NameChanged.InvokeAsync((string?)args.Value ?? string.Empty);

    private Task OnAvatarSelected(string url) => AvatarUrlChanged.InvokeAsync(url);

    private Task OnSpectatorChanged(ChangeEventArgs args) => IsSpectatorChanged.InvokeAsync((bool)(args.Value ?? false));
}
