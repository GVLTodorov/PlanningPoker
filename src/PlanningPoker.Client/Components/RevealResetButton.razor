@if (Status == RoundStatus.Voting)
{
    @if (IsHost)
    {
        <button type="button" class="primary-button reveal-button" disabled="@(!CanReveal)" @onclick="OnReveal">
            Reveal
        </button>
    }
    else
    {
        <p class="reveal-waiting">Waiting for the host to reveal…</p>
    }
}
else if (IsHost)
{
    <button type="button" class="primary-button reset-button" @onclick="OnReset">
        Reset
    </button>
}
else
{
    <p class="reveal-waiting">Waiting for the host to reset…</p>
}

@code {
    private RoundStatus _lastStatus;
    private bool _lastCanReveal;
    private bool _lastIsHost;
    private bool _firstRender = true;

    [Parameter]
    public RoundStatus Status { get; set; }

    [Parameter]
    public bool CanReveal { get; set; }

    [Parameter]
    public bool IsHost { get; set; }

    [Parameter]
    public EventCallback OnReveal { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    // Same spot occupies this row regardless of how many other players pick a card, so it only
    // needs to re-render when the values that actually change its content change.
    protected override bool ShouldRender()
    {
        var changed = _firstRender || Status != _lastStatus || CanReveal != _lastCanReveal || IsHost != _lastIsHost;
        _firstRender = false;
        _lastStatus = Status;
        _lastCanReveal = CanReveal;
        _lastIsHost = IsHost;
        return changed;
    }
}
