@page "/{RoomId}"
@implements IAsyncDisposable
@inject PlayerSessionState Session
@inject NavigationManager Navigation
@inject RoomApiClient RoomApi
@inject IJSRuntime JsRuntime

<section class="screen board-screen">
    @if (_state is null)
    {
        <p>Connecting…</p>
    }
    else
    {
        <header class="board-header">
            <div class="page-title">
                <a href="/" class="home-link" aria-label="Back to home">
                    <img src="favicon.svg" alt="" class="home-icon" />
                </a>
                <h1>@_state.Name</h1>
            </div>
            <button type="button" class="secondary-button icon-button" @onclick="CopyInviteLinkAsync"
                    title="@(_linkCopied ? "Link copied!" : "Copy invite link")"
                    aria-label="@(_linkCopied ? "Link copied!" : "Copy invite link")">
                @if (_linkCopied)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                }
            </button>
        </header>

        <div class="field">
            <span class="field-label">Deck</span>
            <p class="deck-readonly">@CurrentDeckSummary</p>
        </div>

        <PlayerList Players="_state.Players" LocalPlayerId="_playerId" IsHost="IsHost" OnRemovePlayer="RemovePlayerAsync" />

        <HandSelector Deck="CurrentDeck" SelectedCardIndex="_myCardIndex"
                      Disabled="@(Session.IsSpectator || _state.Status == RoundStatus.Revealed)"
                      SelectedCardIndexChanged="PickCardAsync" />

        <RevealResetButton Status="_state.Status" CanReveal="CanReveal" IsHost="IsHost" OnReveal="RevealAsync" OnReset="ResetAsync" />
    }
</section>

@code {
    [Parameter]
    public string RoomId { get; set; } = string.Empty;

    private GameHubClient? _hub;
    private RoomStateDto? _state;
    private Guid _playerId;
    private IReadOnlyList<DeckDto> _decks = [];
    private bool _linkCopied;
    private int? _myCardIndex;
    private IJSObjectReference? _jsModule;

    private IReadOnlyList<CardOptionDto> CurrentDeck =>
        _decks.FirstOrDefault(d => d.DeckType == _state?.DeckType)?.Cards ?? [];

    private string CurrentDeckSummary =>
        _decks.FirstOrDefault(d => d.DeckType == _state?.DeckType) is { } deck
            ? $"{deck.DisplayName} ({string.Join(", ", deck.Cards.Select(c => c.Label))})"
            : string.Empty;

    private bool IsHost => _state?.Players.FirstOrDefault(p => p.PlayerId == _playerId)?.IsHost ?? false;

    private bool CanReveal =>
        IsHost &&
        _state is { Status: RoundStatus.Voting } state &&
        state.Players.Where(p => !p.IsSpectator).ToList() is { Count: > 0 } activePlayers &&
        activePlayers.All(p => p.HasPicked);

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();

        if (string.IsNullOrWhiteSpace(Session.PlayerName))
        {
            Navigation.NavigateTo($"/{RoomId}/join");
            return;
        }

        _decks = await RoomApi.GetDecksAsync();

        _hub = new GameHubClient(Navigation);
        _hub.RoomStateChanged += OnRoomStateChanged;
        _hub.PlayerPickChanged += OnPlayerPickChanged;
        _hub.RoundRevealed += OnRoundRevealed;
        _hub.RoundReset += OnRoundReset;
        _hub.RemovedFromRoom += OnRemovedFromRoom;

        await _hub.StartAsync();
        var result = await _hub.JoinRoomAsync(RoomId, Session.PlayerName, Session.IsSpectator, Session.AvatarUrl);
        _playerId = result.PlayerId;
        _state = result.State;
    }

    private void OnRoomStateChanged(RoomStateDto state)
    {
        _state = state;
        InvokeAsync(StateHasChanged);
    }

    private void OnPlayerPickChanged(PlayerPickStatusChanged change)
    {
        if (_state is null)
        {
            return;
        }

        _state = _state with
        {
            Players = _state.Players
                .Select(p => p.PlayerId == change.PlayerId ? p with { HasPicked = change.HasPicked } : p)
                .ToList(),
        };

        InvokeAsync(StateHasChanged);
    }

    private void OnRoundRevealed(RoundRevealed revealed)
    {
        if (_state is null)
        {
            return;
        }

        _state = _state with { Status = RoundStatus.Revealed, Players = revealed.Players.ToList() };
        InvokeAsync(StateHasChanged);
    }

    private void OnRoundReset()
    {
        if (_state is null)
        {
            return;
        }

        _state = _state with
        {
            Status = RoundStatus.Voting,
            Players = _state.Players.Select(p => p with { HasPicked = false, Card = null }).ToList(),
        };
        _myCardIndex = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnRemovedFromRoom()
    {
        Session.PlayerName = string.Empty;
        Session.AvatarUrl = null;
        InvokeAsync(async () =>
        {
            await Session.SaveAsync();
            Navigation.NavigateTo("/?removed=true");
        });
    }

    private async Task PickCardAsync(int? cardIndex)
    {
        _myCardIndex = cardIndex;
        if (_hub is not null)
        {
            await _hub.PickCardAsync(cardIndex);
        }
    }

    private Task RevealAsync() => _hub?.RevealAsync() ?? Task.CompletedTask;

    private Task ResetAsync() => _hub?.ResetAsync() ?? Task.CompletedTask;

    private Task RemovePlayerAsync(Guid targetPlayerId) => _hub?.RemovePlayerAsync(targetPlayerId) ?? Task.CompletedTask;

    private async Task CopyInviteLinkAsync()
    {
        _jsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var url = Navigation.ToAbsoluteUri($"/{RoomId}").ToString();
        await _jsModule.InvokeVoidAsync("copyToClipboard", url);
        _linkCopied = true;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            _hub.RoomStateChanged -= OnRoomStateChanged;
            _hub.PlayerPickChanged -= OnPlayerPickChanged;
            _hub.RoundRevealed -= OnRoundRevealed;
            _hub.RoundReset -= OnRoundReset;
            _hub.RemovedFromRoom -= OnRemovedFromRoom;
            await _hub.DisposeAsync();
        }

        if (_jsModule is not null)
        {
            await _jsModule.DisposeAsync();
        }
    }
}
