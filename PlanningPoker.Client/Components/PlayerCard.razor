@inject IJSRuntime JsRuntime

<div class="player-card @(Player.IsSpectator ? "player-card-spectator" : "") @(IsLocalPlayer ? "player-card-local" : "")">
    @if (!string.IsNullOrEmpty(Player.AvatarUrl))
    {
        <div class="player-card-background" style="background-image:url('@Player.AvatarUrl')"></div>
    }

    @if (CanRemove)
    {
        <button type="button" class="player-card-remove" aria-label="Remove @Player.Name" @onclick="ConfirmAndRemoveAsync">
            &times;
        </button>
    }

    <div class="player-card-content">
        <span class="player-card-name">@Player.Name</span>

        @if (Player.IsSpectator)
        {
            <span class="player-card-badge">Spectator</span>
        }
        else if (Player.Card is not null)
        {
            <span class="player-card-value">@Player.Card.Label</span>
        }
        else if (Player.HasPicked)
        {
            <span class="player-card-picked" aria-label="Picked a card">&#10003;</span>
        }
        else
        {
            <span class="player-card-waiting" aria-label="Waiting for a pick"></span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public PlayerDto Player { get; set; } = null!;

    [Parameter]
    public bool IsLocalPlayer { get; set; }

    [Parameter]
    public bool CanRemove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private IJSObjectReference? _jsModule;

    private async Task ConfirmAndRemoveAsync()
    {
        _jsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var confirmed = await _jsModule.InvokeAsync<bool>("confirmAction", $"Remove {Player.Name} from the room?");
        if (confirmed)
        {
            await OnRemove.InvokeAsync();
        }
    }
}
